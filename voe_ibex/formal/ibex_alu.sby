# Formal jobs for the REAL ibex_alu (RV32BNone), hybrid frontend:
#   * DUT  = sv2v-converted plain Verilog (gen/ibex_alu.v / gen/ibex_alu_mut.v)
#   * harness (ibex_alu_fv.v) read DIRECTLY by yosys so the assert/assume live.
# Four per-op-class proofs over the byte-identical corpus RTL (expect pass) and
# one bug job over a narrowly-mutated copy (expect a counterexample).
# mode prove = k-induction => a genuine unbounded proof (recorded as deductive).
#
# bug_logic MUST fail (counterexample). It is the self-check that the assertions
# are actually present — an all-sv2v flow made it pass vacuously; this hybrid
# fixes that. A green board with bug_logic passing is NOT to be trusted.

[tasks]
prove_add
prove_logic
prove_shift
prove_cmp
prove_result
prove_adder
prove_adder_ext
prove_imd
bug_logic

# ibex_alu is purely combinational (no clock/flops), so a bmc pass that actually
# evaluates the assertions is exhaustive over all inputs = a complete proof.
# (k-induction 'mode prove' gives spurious induction counterexamples over
# unreachable states for a stateless DUT.)
# depth 2 is REQUIRED, not cosmetic: the harness assertions are clocked
# (always @(posedge clk)), so they are first evaluated at step 1. At depth 1
# only step 0 exists, no edge has occurred, and every task passes vacuously.
[options]
mode bmc
depth 2
prove_add:       expect pass
prove_logic:     expect pass
prove_shift:     expect pass
prove_cmp:       expect pass
prove_result:    expect pass
prove_adder:     expect pass
prove_adder_ext: expect pass
prove_imd:       expect pass
bug_logic:       expect fail

[engines]
smtbmc z3

[script]
prove_add:       verilog_defines -DCLASS_ADD
prove_logic:     verilog_defines -DCLASS_LOGIC
prove_shift:     verilog_defines -DCLASS_SHIFT
prove_cmp:       verilog_defines -DCLASS_CMP
prove_result:    verilog_defines -DCLASS_RESULT
prove_adder:     verilog_defines -DCLASS_ADDER
prove_adder_ext: verilog_defines -DCLASS_ADDER_EXT
prove_imd:       verilog_defines -DCLASS_IMD
bug_logic:       verilog_defines -DCLASS_LOGIC -DDUT=ibex_alu_mut
prove_add:       read_verilog ibex_alu.v
prove_logic:     read_verilog ibex_alu.v
prove_shift:     read_verilog ibex_alu.v
prove_cmp:       read_verilog ibex_alu.v
prove_result:    read_verilog ibex_alu.v
prove_adder:     read_verilog ibex_alu.v
prove_adder_ext: read_verilog ibex_alu.v
prove_imd:       read_verilog ibex_alu.v
bug_logic:       read_verilog ibex_alu_mut.v
read_verilog -sv ibex_alu_fv.v
prep -top ibex_alu_fv

[files]
gen/ibex_alu.v
gen/ibex_alu_mut.v
ibex_alu_fv.v
