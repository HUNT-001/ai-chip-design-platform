# BOUNDED model check of the real cv32e40p_fifo.
#
# This file exists to be honest about what bounded checking buys on a STATEFUL
# design. A pass here means "no violation within 12 cycles of reset" — the
# counter could still overflow at cycle 13. The evidence adapter therefore
# records a pass from this file as `bounded_pass`: strong inductive evidence
# that lowers residual risk, but NEVER a proof and never a discharge to zero.
# fifo_prove.sby runs the same properties with k-induction for a real proof.
#
# bug_cnt is the vacuity gate: the mutated FIFO (full_o one slot late) lets the
# counter reach 5, so the bound MUST fail against it.

[tasks]
bmc_cnt
bmc_flags
bmc_overflow
bug_cnt

[options]
mode bmc
depth 12
bmc_cnt:      expect pass
bmc_flags:    expect pass
bmc_overflow: expect pass
bug_cnt:      expect fail

[engines]
smtbmc z3

[script]
bmc_cnt:      verilog_defines -DCLASS_CNT_BOUND
bmc_flags:    verilog_defines -DCLASS_FLAGS
bmc_overflow: verilog_defines -DCLASS_NO_OVERFLOW
bug_cnt:      verilog_defines -DCLASS_CNT_BOUND -DDUT=fifo_wrap_mut
bmc_cnt:      read_verilog fifo.v
bmc_flags:    read_verilog fifo.v
bmc_overflow: read_verilog fifo.v
bug_cnt:      read_verilog fifo_mut.v
read_verilog -sv fifo_fv.v
prep -top fifo_fv

[files]
gen/fifo.v
gen/fifo_mut.v
fifo_fv.v
